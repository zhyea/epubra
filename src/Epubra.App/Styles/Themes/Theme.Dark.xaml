<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
    ============================================================
      Epubra 主题 · 深色 (Dark) — WPS 蓝
      ==============================
      深底浅字，长时间夜间写作场景。主强调色提亮为 WPS 蓝系，
      在深底上保持高对比与可读性。
    ============================================================
    -->

    <!-- == 表面 Surface == -->
    <SolidColorBrush x:Key="SurfaceBase" Color="#FF1E1F22" />
    <SolidColorBrush x:Key="SurfaceSunken" Color="#FF181A1D" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#FF26282C" />
    <SolidColorBrush x:Key="SurfaceMuted" Color="#FF2D2F34" />
    <SolidColorBrush x:Key="SurfaceOverlay" Color="#FF2A2D31" />
    <SolidColorBrush x:Key="SurfaceAccentSubtle" Color="#FF1E3450" />

    <!-- == 描边 Border == -->
    <SolidColorBrush x:Key="BorderSubtle" Color="#FF3A3D42" />
    <SolidColorBrush x:Key="BorderDefault" Color="#FF4A4E55" />
    <SolidColorBrush x:Key="BorderStrong" Color="#FF5C616A" />
    <SolidColorBrush x:Key="BorderAccent" Color="#FF4D94FF" />

    <!-- == 文本 Text == -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF1F3F5" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FFC7CDD4" />
    <SolidColorBrush x:Key="TextTertiary" Color="#FF9AA1AA" />
    <SolidColorBrush x:Key="TextPlaceholder" Color="#FF868E96" />
    <SolidColorBrush x:Key="TextDisabled" Color="#FF6C757D" />
    <SolidColorBrush x:Key="TextAccent" Color="#FF8FB8FF" />
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextDanger" Color="#FFFF6B6B" />

    <!-- == 强调 Accent == -->
    <SolidColorBrush x:Key="AccentDefault" Color="#FF4D94FF" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF66A3FF" />
    <SolidColorBrush x:Key="AccentPressed" Color="#FF99C2FF" />
    <SolidColorBrush x:Key="AccentDisabled" Color="#FF3A3D42" />

    <!-- == 交互状态 State == -->
    <SolidColorBrush x:Key="StateHover" Color="#FF2D2F34" />
    <SolidColorBrush x:Key="StatePressed" Color="#FF35383D" />
    <SolidColorBrush x:Key="StateSelected" Color="#FF1E3450" />
    <SolidColorBrush x:Key="StateSelectedHover" Color="#FF264061" />
    <SolidColorBrush x:Key="FocusRing" Color="#FF8FB8FF" />

    <!-- == 语义反馈 Feedback == -->
    <SolidColorBrush x:Key="FeedbackSuccess" Color="#FF51CF66" />
    <SolidColorBrush x:Key="FeedbackSuccessBg" Color="#FF1C2B1F" />
    <SolidColorBrush x:Key="FeedbackWarning" Color="#FFFFA94D" />
    <SolidColorBrush x:Key="FeedbackWarningBg" Color="#FF33260F" />
    <SolidColorBrush x:Key="FeedbackDanger" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="FeedbackDangerBg" Color="#FF33181A" />

    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <!-- == 标题栏 TitleBar（随主题切换） == -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FF1F2A3A" />
    <SolidColorBrush x:Key="TitleBarButtonHover" Color="#FF2E3D52" />
    <SolidColorBrush x:Key="TitleBarButtonCloseHover" Color="#FFE54848" />
    <SolidColorBrush x:Key="TitleBarForeground" Color="#FFE6EDF5" />

    <!-- 主题字典标记：供 ThemeService 定位并热替换当前主题字典 -->
    <sys:Boolean x:Key="__ThemeDictionary__">True</sys:Boolean>

</ResourceDictionary>
