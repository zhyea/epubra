<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
    ============================================================
      Epubra 主题 · 浅色 (Light) — WPS 蓝
      ==============================
      语义层实现，键名与三套主题完全一致。主强调色已统一为
      WPS 经典蓝 #2B7FFF，选中/悬停态配套提亮，正文文字在浅底
      上均满足 WCAG AA (≥4.5:1) 对比度。
    ============================================================
    -->

    <!-- == 表面 Surface == -->
    <SolidColorBrush x:Key="SurfaceBase" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceSunken" Color="#FFFCFCFD" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#FFF8F9FA" />
    <SolidColorBrush x:Key="SurfaceMuted" Color="#FFF1F3F5" />
    <SolidColorBrush x:Key="SurfaceOverlay" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceAccentSubtle" Color="#FFE8F1FF" />

    <!-- == 描边 Border == -->
    <SolidColorBrush x:Key="BorderSubtle" Color="#FFE9ECEF" />
    <SolidColorBrush x:Key="BorderDefault" Color="#FFDEE2E6" />
    <SolidColorBrush x:Key="BorderStrong" Color="#FFCED4DA" />
    <SolidColorBrush x:Key="BorderAccent" Color="#FF2B7FFF" />

    <!-- == 文本 Text == -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FF343A40" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FF6C757D" />
    <SolidColorBrush x:Key="TextTertiary" Color="#FF868E96" />
    <SolidColorBrush x:Key="TextPlaceholder" Color="#FFADB5BD" />
    <SolidColorBrush x:Key="TextDisabled" Color="#FFADB5BD" />
    <SolidColorBrush x:Key="TextAccent" Color="#FF1452B8" />
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextDanger" Color="#FFD62828" />

    <!-- == 强调 Accent == -->
    <SolidColorBrush x:Key="AccentDefault" Color="#FF2B7FFF" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF1A66E6" />
    <SolidColorBrush x:Key="AccentPressed" Color="#FF1452B8" />
    <SolidColorBrush x:Key="AccentDisabled" Color="#FFCED4DA" />

    <!-- == 交互状态 State == -->
    <SolidColorBrush x:Key="StateHover" Color="#FFE9ECEF" />
    <SolidColorBrush x:Key="StatePressed" Color="#FFDEE2E6" />
    <SolidColorBrush x:Key="StateSelected" Color="#FFE8F1FF" />
    <SolidColorBrush x:Key="StateSelectedHover" Color="#FFCCE0FF" />
    <SolidColorBrush x:Key="FocusRing" Color="#FF3399FF" />

    <!-- == 语义反馈 Feedback == -->
    <SolidColorBrush x:Key="FeedbackSuccess" Color="#FF2F9E44" />
    <SolidColorBrush x:Key="FeedbackSuccessBg" Color="#FFEBFBEE" />
    <SolidColorBrush x:Key="FeedbackWarning" Color="#FFE8590C" />
    <SolidColorBrush x:Key="FeedbackWarningBg" Color="#FFFFF4E6" />
    <SolidColorBrush x:Key="FeedbackDanger" Color="#FFD62828" />
    <SolidColorBrush x:Key="FeedbackDangerBg" Color="#FFFFF0F0" />

    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <!-- == 标题栏 TitleBar（随主题切换） == -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FF2B7FFF" />
    <SolidColorBrush x:Key="TitleBarButtonHover" Color="#FF4D94FF" />
    <SolidColorBrush x:Key="TitleBarButtonCloseHover" Color="#FFE54848" />
    <SolidColorBrush x:Key="TitleBarForeground" Color="#FFFFFFFF" />

    <!-- 主题字典标记：供 ThemeService 定位并热替换当前主题字典 -->
    <sys:Boolean x:Key="__ThemeDictionary__">True</sys:Boolean>

</ResourceDictionary>
