<Window x:Class="Epubra.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:conv="clr-namespace:Epubra.App.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource SurfaceBase}"
        Loaded="MainWindow_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="8" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        <HierarchicalDataTemplate x:Key="ChapterTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportEpubCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProjectCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FindReplaceCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- ====== 自定义标题栏（WPS 风格） ====== -->
        <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="40"
                Background="{DynamicResource TitleBarBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左：应用菜单 + Logo + 应用名 + 文档标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                    <!-- 应用菜单（替代原菜单栏，承载 关于/退出 等独有项） -->
                    <Button x:Name="AppMenuButton" Style="{StaticResource QatButton}" ToolTip="菜单" Click="AppMenuButton_Click" Margin="0,0,4,0">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconMenu}" />
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AppMenu">
                                <MenuItem Header="切换主题" Click="TitleBarTheme_Click" />
                                <MenuItem Header="折叠/展开工具栏" Click="ToggleRibbon_Click" />
                                <Separator />
                                <MenuItem Header="关于 Epubra" Click="About_Click" />
                                <MenuItem Header="退出" Click="Exit_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource TitleBarForeground}" Opacity="0.22" Margin="0,0,6,0" />
                    <!-- 品牌 Logo：圆角矩形背景 + 内部书脊图案 -->
                    <Border Width="24" Height="24" CornerRadius="5"
                            Background="{DynamicResource TextAccent}"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                        <Canvas Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Stroke="White" StrokeThickness="1.2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M2,1 H12 V13 H2 Z M5.5,1 V13 M8.5,1 V13 M10,5 H11.5 M10,7.5 H11.5" />
                        </Canvas>
                    </Border>
                    <!-- 品牌名 + 副标题 -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Epubra" Foreground="{DynamicResource TitleBarForeground}"
                                   FontFamily="{StaticResource FontUI}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="EPUB 书籍编辑器" Foreground="{DynamicResource TitleBarForeground}"
                                   Opacity="0.62" FontFamily="{StaticResource FontUI}" FontSize="10" Margin="0,-1,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding WindowTitle}" Foreground="{DynamicResource TitleBarForeground}"
                               Opacity="0.78" FontFamily="{StaticResource FontUI}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,0,0" />
                </StackPanel>

                <!-- 中：快速访问工具栏 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <Button Style="{StaticResource QatButton}" ToolTip="新建项目 (Ctrl+N)" Command="{Binding NewProjectCommand}">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconNew}" />
                    </Button>
                    <Button Style="{StaticResource QatButton}" ToolTip="打开项目 (Ctrl+O)" Command="{Binding OpenProjectCommand}">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconOpen}" />
                    </Button>
                    <Button Style="{StaticResource QatButton}" ToolTip="保存项目 (Ctrl+S)" Command="{Binding SaveProjectCommand}">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSave}" />
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource TitleBarForeground}" Opacity="0.22" Margin="4,0" />
                    <Button Style="{StaticResource QatButton}" ToolTip="撤销 (Ctrl+Z)" Command="{Binding UndoCommand}">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconUndo}" />
                    </Button>
                    <Button Style="{StaticResource QatButton}" ToolTip="重做 (Ctrl+Y)" Command="{Binding RedoCommand}">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRedo}" />
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource TitleBarForeground}" Opacity="0.22" Margin="4,0" />
                    <Button Style="{StaticResource QatButton}" ToolTip="一键排版" Command="{Binding AutoFormatChapterCommand}">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconMagicFormat}" />
                    </Button>
                    <ToggleButton x:Name="TitleBarPreviewBtn" Style="{StaticResource QatToggleButton}"
                                  IsChecked="{Binding IsPreviewMode, Mode=TwoWay}" ToolTip="预览模式">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPreview}" />
                    </ToggleButton>
                    <ComboBox x:Name="ThemeCombo" Width="92" SelectionChanged="ThemeCombo_SelectionChanged"
                              ToolTip="切换界面主题（重启后仍生效）">
                        <ComboBoxItem Tag="Light" Content="浅色" />
                        <ComboBoxItem Tag="Dark" Content="深色" />
                        <ComboBoxItem Tag="Sepia" Content="护眼" />
                    </ComboBox>
                </StackPanel>

                <!-- 右：窗口控制 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleBarButton}" ToolTip="最小化" Click="Minimize_Click">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconMinimize}" />
                    </Button>
                    <Button x:Name="MaxRestoreBtn" Style="{StaticResource TitleBarButton}" ToolTip="最大化" Click="MaximizeRestore_Click">
                        <Path x:Name="MaxRestoreIcon" Style="{StaticResource IconPath}" Data="{StaticResource IconMaximize}" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}" ToolTip="关闭" Click="Close_Click">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconClose}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== Ribbon 工具栏 ====== -->
        <TabControl x:Name="RibbonTabs" DockPanel.Dock="Top"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtle}"
                    Background="{DynamicResource SurfaceBase}" Padding="0"
                    MouseDoubleClick="RibbonTabs_MouseDoubleClick"
                    PreviewMouseLeftButtonDown="RibbonTabs_PreviewMouseLeftButtonDown">

            <!-- ====== Tab: 开始 ====== -->
            <TabItem Style="{StaticResource RibbonTab}" Header="开始">
                <StackPanel Orientation="Horizontal" Background="Transparent" Height="98">
                    <!-- Group: 书籍（与 epubBuilder 截图对齐：项目级操作入口） -->
                    <Border Style="{StaticResource RibbonGroup}">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Button Style="{StaticResource RBtnIconText}" Command="{Binding NewProjectCommand}" ToolTip="新建项目 (Ctrl+N)">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconNew}" HorizontalAlignment="Center" />
                                        <TextBlock Text="新建" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RBtnIconText}" Command="{Binding OpenProjectCommand}" ToolTip="打开项目 (Ctrl+O)">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconOpen}" HorizontalAlignment="Center" />
                                        <TextBlock Text="打开" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RBtnIconText}" Command="{Binding SaveProjectCommand}" ToolTip="保存项目 (Ctrl+S)">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSave}" HorizontalAlignment="Center" />
                                        <TextBlock Text="保存" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RBtnIconText}" Click="ShowMetadata_Click" ToolTip="书籍设置：元数据 / 封面 / Markdown 简介">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconInfo}" HorizontalAlignment="Center" />
                                        <TextBlock Text="书籍设置" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RBtnIconText}" Click="Close_Click" ToolTip="关闭窗口（关闭前会提示保存）">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconClose}" HorizontalAlignment="Center" />
                                        <TextBlock Text="关闭" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource GroupLabel}" Text="书籍" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ====== Tab: 导入 ====== -->
            <TabItem Style="{StaticResource RibbonTab}" Header="导入">
                <StackPanel Orientation="Horizontal" Background="Transparent" Height="98">
                    <Border Style="{StaticResource RibbonGroup}">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Button Style="{StaticResource RBtnIconText}" Command="{Binding ImportTxtCommand}" ToolTip="导入纯文本 TXT 并自动识别章节">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconImport}" HorizontalAlignment="Center" />
                                        <TextBlock Text="导入 TXT" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RBtnIconText}" Command="{Binding ImportEpubCommand}" ToolTip="导入现有 EPUB 文件为可编辑项目">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconBookCover}" HorizontalAlignment="Center" />
                                        <TextBlock Text="导入 EPUB" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource GroupLabel}" Text="本地文件" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ====== Tab: 插入 ====== -->
            <TabItem Style="{StaticResource RibbonTab}" Header="插入">
                <StackPanel Orientation="Horizontal" Background="Transparent" Height="98">
                    <Border Style="{StaticResource RibbonGroup}">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Button Style="{StaticResource RBtnIconText}" Click="InsertImage_Click" ToolTip="插入图片">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconImage}" HorizontalAlignment="Center" />
                                        <TextBlock Text="插入图片" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <!-- 「封面」与「书籍信息」按钮已迁到「开始 Tab → 书籍组 → 书籍设置」 -->
                            </StackPanel>
                            <TextBlock Style="{StaticResource GroupLabel}" Text="图片" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroup}">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Button Style="{StaticResource RBtnIconText}" Click="InsertAudio_Click" ToolTip="插入音频文件到当前章节">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconAudio}" HorizontalAlignment="Center" />
                                        <TextBlock Text="插入音频" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource GroupLabel}" Text="媒体" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroup}">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Button Style="{StaticResource RBtnIconText}" Click="Hyperlink_Click" ToolTip="插入超链接 (Ctrl+K)">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconLink}" HorizontalAlignment="Center" />
                                        <TextBlock Text="超链接" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource GroupLabel}" Text="链接" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroup}">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Button Style="{StaticResource RBtnIconText}" Click="HorizontalLine_Click" ToolTip="插入水平分隔线">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconHorizontalRule}" HorizontalAlignment="Center" />
                                        <TextBlock Text="水平线" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource GroupLabel}" Text="页面" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroup}">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Button Style="{StaticResource RBtnIconText}" Click="Table_Click" ToolTip="插入表格">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconTable}" HorizontalAlignment="Center" />
                                        <TextBlock Text="表格" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource GroupLabel}" Text="表格" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>


            <!-- ====== Tab: 编辑 ====== -->
            <TabItem Style="{StaticResource RibbonTab}" Header="编辑">
                <StackPanel Orientation="Horizontal" Background="Transparent" Height="98">

                    <!-- Group: 查找替换 -->
                    <Border Style="{StaticResource RibbonGroup}">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Button Style="{StaticResource RBtnM}" Content="查找" Click="FindReplace_Click" ToolTip="查找 (Ctrl+F)" />
                                <Button Style="{StaticResource RBtnM}" Content="替换" Click="FindReplace_Click" ToolTip="替换 (Ctrl+H)" />
                                <ToggleButton x:Name="CaseSensitiveToggle" Style="{StaticResource RToggleS}"
                                              Content="Aa" ToolTip="区分大小写"
                                              IsChecked="{Binding CaseSensitive, Mode=TwoWay}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource GroupLabel}" Text="查找替换" />
                        </StackPanel>
                    </Border>

                    <!-- Group: 拆分章节规则 -->
                    <Border Style="{StaticResource RibbonGroup}">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Margin="0,1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 智能 -->
                                <ToggleButton Grid.Row="0" Grid.Column="0" Style="{StaticResource RToggleS}" Width="56" Margin="0,1"
                                              Content="智能" ToolTip="按章节标记智能识别（第X章/前言/Chapter N 等）"
                                              IsChecked="{Binding SplitSmartEnabled, Mode=TwoWay}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="标题长度≤" VerticalAlignment="Center"
                                           Margin="8,1,4,1" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                <TextBox Grid.Row="0" Grid.Column="2" Height="24" VerticalContentAlignment="Center" Margin="0,1"
                                         Text="{Binding SplitMaxTitleLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="只把整行长度 ≤ 该值的视为章节标题，避免误把正文长句当章节" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="字" VerticalAlignment="Center"
                                           Margin="4,1,0,1" Foreground="{DynamicResource TextTertiary}" FontSize="11" />

                                <!-- 等长 -->
                                <ToggleButton Grid.Row="1" Grid.Column="0" Style="{StaticResource RToggleS}" Width="56" Margin="0,1"
                                              Content="等长" ToolTip="按字节数强制切分（兜底用）"
                                              IsChecked="{Binding SplitEqualLengthEnabled, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="长度" VerticalAlignment="Center"
                                           Margin="8,1,4,1" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                <TextBox Grid.Row="1" Grid.Column="2" Height="24" VerticalContentAlignment="Center" Margin="0,1"
                                         Text="{Binding SplitByteLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="字节数阈值（UTF-8 编码）" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="字节" VerticalAlignment="Center"
                                           Margin="4,1,0,1" Foreground="{DynamicResource TextTertiary}" FontSize="11" />

                                <!-- 特征 -->
                                <ToggleButton Grid.Row="2" Grid.Column="0" Style="{StaticResource RToggleS}" Width="56" Margin="0,1"
                                              Content="特征" ToolTip="按用户提供的字符串或正则切分"
                                              IsChecked="{Binding SplitFeatureEnabled, Mode=TwoWay}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="模式" VerticalAlignment="Center"
                                           Margin="8,1,4,1" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                <TextBox Grid.Row="2" Grid.Column="2" Height="24" VerticalContentAlignment="Center" Margin="0,1"
                                         Text="{Binding SplitFeaturePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="字符串或正则表达式（如 '第\d+章'）" />
                            </Grid>
                            <TextBlock Style="{StaticResource GroupLabel}" Text="拆分章节" />
                        </StackPanel>
                    </Border>

                    <!-- Group: 执行 -->
                    <Border Style="{StaticResource RibbonGroup}">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Button Style="{StaticResource RBtnAccent}" Command="{Binding StartSplitCommand}"
                                        ToolTip="按上方启用的规则切分当前章节">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSplit}" HorizontalAlignment="Center" />
                                        <TextBlock Text="开始拆书" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RBtnM}" Command="{Binding AutoSplitChapterCommand}"
                                        ToolTip="忽略规则，仅按章节标记自动识别切分（兼容旧行为）">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconMagicFormat}" HorizontalAlignment="Center" />
                                        <TextBlock Text="无规则拆分" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource GroupLabel}" Text="执行" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </TabItem>


            <!-- ====== Tab: 发布 ====== -->
            <TabItem Style="{StaticResource RibbonTab}" Header="发布">
                <StackPanel Orientation="Horizontal" Background="Transparent" Height="98">
                    <Border Style="{StaticResource RibbonGroup}">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportEpubCommand}" ToolTip="生成 EPUB 文件">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconExport}" />
                                        <TextBlock Text="生成 EPUB" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource GroupLabel}" Text="EPUB" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroup}">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Button Style="{StaticResource RBtnM}" Content="导出 TXT" Command="{Binding ExportTxtCommand}" ToolTip="导出为纯文本" />
                                <Button Style="{StaticResource RBtnM}" Content="导出 HTML" Command="{Binding ExportHtmlCommand}" ToolTip="导出为 HTML" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource GroupLabel}" Text="其他格式" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroup}">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <Button Style="{StaticResource RBtnIconText}" Click="EmbedFont_Click" ToolTip="嵌入字体到 EPUB">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFont}" HorizontalAlignment="Center" />
                                        <TextBlock Text="嵌入字体" Margin="0,2,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource GroupLabel}" Text="字体" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- ====== 状态栏（带图标分区） ====== -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceSunken}"
                   BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                   Padding="6,2">
            <!-- 左侧：保存状态点 -->
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="SaveStatusDot" Width="8" Height="8" Margin="0,0,6,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource TextTertiary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SaveStatus}" Value="已修改">
                                        <Setter Property="Fill" Value="#FFA000" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SaveStatus}" Value="已保存">
                                        <Setter Property="Fill" Value="#43A047" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding SaveStatus}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <!-- 当前书名 -->
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Style="{StaticResource IconPathStatic}" Data="{StaticResource IconBookCover}" Width="13" Height="13" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding BookTitle}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"
                               ToolTip="{Binding BookTitle}" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <!-- 当前章节 -->
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Style="{StaticResource IconPathStatic}" Data="{StaticResource IconBulletList}" Width="13" Height="13" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding CurrentChapterName}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"
                               ToolTip="{Binding CurrentChapterName}" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <!-- 状态消息 -->
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondary}" />
            </StatusBarItem>

            <!-- 中段：字数统计 -->
            <Separator />
            <StatusBarItem>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}">
                    <Run Text="{Binding ChapterCount, Mode=OneWay}" />
                    <Run Text=" 章" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}">
                    <Run Text="{Binding WordCount, Mode=OneWay}" />
                    <Run Text=" 字" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}">
                    <Run Text="{Binding CharCount, Mode=OneWay}" />
                    <Run Text=" 字符" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}">
                    <Run Text="{Binding ChapterSize, Mode=OneWay}" />
                    <Run Text=" 字节" />
                </TextBlock>
            </StatusBarItem>

            <!-- 右侧：视图缩放（WPS 风格） -->
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ZoomOutBtn" Style="{StaticResource GhostIconButton}" ToolTip="缩小" Click="ZoomOut_Click">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconZoomOut}" />
                    </Button>
                    <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" Margin="8,0"
                               FontFamily="{StaticResource FontUI}" FontSize="{StaticResource FontSizeSm}"
                               Foreground="{DynamicResource TextSecondary}" />
                    <Button x:Name="ZoomInBtn" Style="{StaticResource GhostIconButton}" ToolTip="放大" Click="ZoomIn_Click">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconZoomIn}" />
                    </Button>
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderSubtle}" Margin="8,0" />
                    <Button Style="{StaticResource GhostIconButton}" ToolTip="适应宽度 (100%)" Click="ZoomFit_Click">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCollapse}" />
                    </Button>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- ====== 主内容区：左章节树 + 右编辑/预览区 ====== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：章节树 -->
            <DockPanel Grid.Column="0">
                <!-- 章节树面板头 -->
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource IconPathStatic}" Data="{StaticResource IconBookCover}" Width="16" Height="16" Margin="0,0,7,0" />
                            <TextBlock Style="{StaticResource PanelTitle}" Text="章节目录" />
                            <Border Style="{StaticResource CountBadge}">
                                <TextBlock Style="{StaticResource CountBadgeText}" Text="{Binding Chapters.Count}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostIconButton}" ToolTip="添加章节" Command="{Binding AddChapterCommand}">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconAdd}" />
                            </Button>
                            <Button Style="{StaticResource GhostDangerButton}" ToolTip="删除章节" Command="{Binding DeleteChapterCommand}">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconTrash}" />
                            </Button>
                            <Button Style="{StaticResource GhostIconButton}" ToolTip="上移" Command="{Binding MoveUpCommand}">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconArrowUp}" />
                            </Button>
                            <Button Style="{StaticResource GhostIconButton}" ToolTip="下移" Command="{Binding MoveDownCommand}">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconArrowDown}" />
                            </Button>
                            <Button Style="{StaticResource GhostIconButton}" ToolTip="缩进" Command="{Binding IndentCommand}">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconIndentMore}" />
                            </Button>
                            <Button Style="{StaticResource GhostIconButton}" ToolTip="取消缩进" Command="{Binding OutdentCommand}">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconIndentLess}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 章节树 / 空状态 -->
                <Grid>
                    <TreeView x:Name="ChapterTree"
                              ItemsSource="{Binding Chapters}"
                              ItemTemplate="{StaticResource ChapterTemplate}"
                              SelectedItemChanged="ChapterTree_SelectedItemChanged"
                              MouseDoubleClick="ChapterTree_MouseDoubleClick"
                              KeyDown="ChapterTree_KeyDown"
                              PreviewMouseLeftButtonDown="ChapterTree_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="ChapterTree_PreviewMouseMove"
                              AllowDrop="True"
                              DragEnter="ChapterTree_DragEnter"
                              DragOver="ChapterTree_DragOver"
                              Drop="ChapterTree_Drop"
                              BorderThickness="0"
                              Visibility="{Binding Chapters.Count, Converter={StaticResource CountToVisibility}}">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="添加章节" Command="{Binding AddChapterCommand}" />
                                <MenuItem Header="添加子章节" Command="{Binding AddSubChapterCommand}" />
                                <Separator />
                                <MenuItem Header="重命名 (F2)" Command="{Binding RenameChapterCommand}" />
                                <Separator />
                                <MenuItem Header="上移" Command="{Binding MoveUpCommand}" />
                                <MenuItem Header="下移" Command="{Binding MoveDownCommand}" />
                                <Separator />
                                <MenuItem Header="升级" Command="{Binding PromoteChapterCommand}" />
                                <MenuItem Header="降级" Command="{Binding DemoteChapterCommand}" />
                                <Separator />
                                <MenuItem Header="合并到下一章" Command="{Binding MergeChaptersCommand}" />
                                <MenuItem Header="手动拆分…" Command="{Binding ManualSplitChapterCommand}" />
                                <MenuItem Header="自动切分章节" Command="{Binding AutoSplitChapterCommand}" />
                                <Separator />
                                <MenuItem Header="首行作目录名" Command="{Binding ExtractTocCommand}" />
                                <MenuItem Header="批量重命名…" Command="{Binding BatchRenameChaptersCommand}" />
                                <Separator />
                                <MenuItem Header="一键排版" Command="{Binding AutoFormatChapterCommand}" />
                                <Separator />
                                <MenuItem Header="删除章节" Command="{Binding DeleteChapterCommand}" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>

                    <!-- 空状态引导 -->
                    <Border Background="{DynamicResource SurfaceSunken}"
                            Visibility="{Binding Chapters.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Inverse}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                            <Path Style="{StaticResource IconPathStatic}" Data="{StaticResource IconEmptyBook}"
                                  Width="64" Height="64" StrokeThickness="2" Stroke="{DynamicResource TextTertiary}"
                                  Margin="0,0,0,14" />
                            <TextBlock Text="还没有章节" FontFamily="{StaticResource FontUI}"
                                       FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                            <TextBlock Text="点击下方按钮开始创作，或导入 TXT / EPUB 快速生成目录"
                                       FontFamily="{StaticResource FontUI}" FontSize="{StaticResource FontSizeBase}"
                                       Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"
                                       Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="240" TextAlignment="Center" />
                            <Button Style="{StaticResource PrimaryButton}" Content="添加第一章"
                                    Command="{Binding AddChapterCommand}" Margin="0,16,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- 分割条 -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" />

            <!-- 右侧：编辑/预览区 -->
            <DockPanel Grid.Column="2">
                <!-- 章节标题栏 -->
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{StaticResource IconPathStatic}" Data="{StaticResource IconBookCover}" Width="15" Height="15" Margin="0,0,7,0" />
                        <TextBlock x:Name="CurrentChapterLabel" Text="（未选择章节）" Style="{StaticResource PanelTitle}" />
                    </StackPanel>
                </Border>

                <!-- 查找替换栏（默认隐藏） -->
                <Border x:Name="FindReplaceBar" DockPanel.Dock="Top" Background="{DynamicResource SurfaceRaised}" Padding="8,4"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="查找：" VerticalAlignment="Center" Width="40" />
                            <TextBox x:Name="FindTextBox" Width="250" KeyDown="FindTextBox_KeyDown" />
                            <Button Style="{StaticResource RBtnM}" Content="下一个" Height="24" Margin="4,0,0,0" Click="FindNext_Click" />
                            <Button Style="{StaticResource RBtnM}" Content="上一个" Height="24" Margin="4,0,0,0" Click="FindPrev_Click" />
                            <Button Style="{StaticResource RBtnM}" Content="×" Width="28" Height="24" Margin="4,0,0,0" Click="CloseFindReplace_Click" ToolTip="关闭" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="替换：" VerticalAlignment="Center" Width="40" />
                            <TextBox x:Name="ReplaceTextBox" Width="250" />
                            <Button Style="{StaticResource RBtnM}" Content="替换" Height="24" Margin="4,0,0,0" Click="ReplaceOne_Click" />
                            <Button Style="{StaticResource RBtnM}" Content="全部替换" Height="24" Margin="4,0,0,0" Click="ReplaceAll_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 编辑区（编辑模式时可见） -->
                <RichTextBox x:Name="Editor"
                             Foreground="{DynamicResource TextPrimary}"
                             Background="{DynamicResource SurfaceBase}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="宋体"
                             FontSize="16"
                             Padding="24,12"
                             BorderThickness="0"
                             IsEnabled="False"
                             Visibility="{Binding IsPreviewMode, Converter={StaticResource InverseBoolToVis}}"
                             SelectionChanged="Editor_SelectionChanged"
                             TextChanged="Editor_TextChanged" />

                <!-- 预览区（预览模式时可见） -->
                <wv2:WebView2 x:Name="PreviewViewer"
                              Visibility="{Binding IsPreviewMode, Converter={StaticResource BoolToVis}}"
                              DefaultBackgroundColor="White" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
