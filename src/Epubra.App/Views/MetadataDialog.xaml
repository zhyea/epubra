<Window x:Class="Epubra.App.Views.MetadataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="书籍设置" Width="1080" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="900" MinHeight="600"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBase}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 章节树层级模板：复用 ChapterNode.Children / Title -->
        <HierarchicalDataTemplate x:Key="BookChapterTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <Path Style="{StaticResource IconPathStatic}" Data="{StaticResource IconBulletList}"
                      Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
                      Fill="{DynamicResource TextTertiary}" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}" FontSize="13" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- 分栏小标题 -->
        <Style x:Key="PaneTitle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitle}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- 表单字段标签（60px 宽，右对齐，沿用既有 FieldLabel） -->
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Width" Value="60" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- 卡片内部分栏容器 -->
        <Style x:Key="PaneCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ====== 底部按钮栏 ====== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="取消" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
                <Button Style="{StaticResource PrimaryButton}" Content="确定" IsDefault="True" Click="OK_Click" />
            </StackPanel>
        </Border>

        <!-- ====== 三栏主体 ====== -->
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" MinWidth="340" />
                <ColumnDefinition Width="372" />
            </Grid.ColumnDefinitions>

            <!-- 左：章节结构 -->
            <DockPanel Grid.Column="0" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneTitle}" Text="章节结构" />
                <Border Style="{StaticResource PaneCard}" Background="{DynamicResource SurfaceSunken}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Bottom" x:Name="ChapterHint"
                                   Text="点击章节可在右侧预览" Foreground="{DynamicResource TextTertiary}"
                                   FontSize="11" Margin="2,8,2,0" />
                        <TreeView x:Name="ChapterTree"
                                  ItemsSource="{Binding Chapters}"
                                  ItemTemplate="{StaticResource BookChapterTemplate}"
                                  SelectedItemChanged="ChapterTree_SelectedItemChanged"
                                  Background="Transparent" BorderThickness="0"
                                  Margin="-4,0" />
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- 中：实时预览 -->
            <DockPanel Grid.Column="1" LastChildFill="True" Margin="12,0">
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource PaneTitle}" Text="实时预览" />
                    <Border DockPanel.Dock="Right" x:Name="PreviewModeBadge"
                            Background="{DynamicResource SurfaceAccentSubtle}"
                            BorderBrush="{DynamicResource BorderAccent}" BorderThickness="1"
                            CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="PreviewModeText" Text="书籍信息"
                                   Foreground="{DynamicResource TextAccent}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </DockPanel>
                <Border Style="{StaticResource PaneCard}" Background="{DynamicResource SurfaceSunken}" Padding="0">
                    <Grid>
                        <wv2:WebView2 x:Name="PreviewViewer" DefaultBackgroundColor="White" />
                        <Border x:Name="PreviewFallback" Background="{DynamicResource SurfaceSunken}"
                                Visibility="Collapsed">
                            <TextBlock Text="WebView2 预览不可用，请稍候或在主窗口查看预览"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="24" TextAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- 右：书籍信息表单 -->
            <DockPanel Grid.Column="2" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneTitle}" Text="书籍信息" />
                <Border Style="{StaticResource PaneCard}" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,14,12">
                        <StackPanel>
                            <!-- 封面卡片 -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="12">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="CoverPreviewBorder" Width="104" Height="148"
                                            BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                                            Background="{DynamicResource SurfaceSunken}" CornerRadius="4">
                                        <Grid>
                                            <Image x:Name="CoverPreview" Stretch="Uniform" Visibility="Collapsed" />
                                            <TextBlock x:Name="CoverPlaceholder" Text="无封面"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Path Style="{StaticResource IconPathStatic}" Data="{StaticResource IconBookCover}" Width="15" Height="15" Margin="0,0,6,0" />
                                            <TextBlock Text="封面" Style="{StaticResource PanelTitle}" />
                                        </StackPanel>
                                        <TextBlock x:Name="CoverInfo" Text="未设置封面" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" MaxWidth="180" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Style="{StaticResource SecondaryButton}" Content="选择" Margin="0,0,6,0" Click="BrowseCover_Click" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="剪贴板" Margin="0,0,6,0" Click="PasteCover_Click" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="提取" Margin="0,0,6,0" Click="ExtractCover_Click" />
                                        </StackPanel>
                                        <Button Style="{StaticResource GhostDangerButton}" Content="移除封面" x:Name="RemoveCoverBtn" IsEnabled="False" Click="RemoveCover_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 元数据字段网格 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormLabel}" Text="书名" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TitleBox" Margin="0,0,0,8" TextChanged="Field_TextChanged" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormLabel}" Text="作者" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="AuthorBox" Margin="0,0,0,8" TextChanged="Field_TextChanged" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FormLabel}" Text="类型" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="SubjectBox" Margin="0,0,0,8"
                                         ToolTip="书籍分类/类型，多个以分号分隔，如：小说;科幻" TextChanged="Field_TextChanged" />

                                <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="出版社" Style="{StaticResource FieldLabel}" Width="42" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBox x:Name="PublisherBox" Margin="8,0,0,0" TextChanged="Field_TextChanged" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="ISBN" Style="{StaticResource FieldLabel}" Width="40" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <TextBox Grid.Column="2" x:Name="IsbnBox" Margin="8,0,0,0" TextChanged="Field_TextChanged" />
                                </Grid>

                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FormLabel}" Text="语言" />
                                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="LanguageCombo" Width="120" VerticalContentAlignment="Center" Margin="0,0,0,8"
                                          SelectionChanged="LanguageCombo_SelectionChanged">
                                    <ComboBoxItem Content="zh-CN" IsSelected="True" />
                                    <ComboBoxItem Content="zh-TW" />
                                    <ComboBoxItem Content="en" />
                                    <ComboBoxItem Content="ja" />
                                    <ComboBoxItem Content="ko" />
                                    <ComboBoxItem Content="fr" />
                                    <ComboBoxItem Content="de" />
                                </ComboBox>
                            </Grid>

                            <!-- 简介（Markdown） -->
                            <Border Background="{DynamicResource SurfaceMuted}" CornerRadius="4" Padding="10,8" Margin="0,4,0,8">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Text="简介" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBlock Text="支持 Markdown" Foreground="{DynamicResource TextTertiary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="预览简介" Padding="8,3" FontSize="11" Click="PreviewDescription_Click" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBox x:Name="DescriptionBox" Style="{StaticResource MultilineTextBox}"
                                             Height="150" TextChanged="Description_TextChanged"
                                             AcceptsReturn="True" AcceptsTab="True"
                                             VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="提示：修改上方任意字段，中间预览会实时更新。" Foreground="{DynamicResource TextTertiary}" FontSize="11" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
