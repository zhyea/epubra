<Window x:Class="Epubra.App.Views.MetadataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="书籍信息" Width="600" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="520" MinHeight="560"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBase}">
    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Width" Value="64" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ====== 封面预览区（卡片式） ====== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <!-- 封面图片预览 -->
                <Border x:Name="CoverPreviewBorder" Width="120" Height="170"
                        BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                        Background="{DynamicResource SurfaceSunken}">
                    <Grid>
                        <Image x:Name="CoverPreview" Stretch="Uniform" Visibility="Collapsed" />
                        <TextBlock x:Name="CoverPlaceholder" Text="无封面"
                                   Foreground="{DynamicResource TextTertiary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                    </Grid>
                </Border>

                <!-- 封面操作 -->
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Path Style="{StaticResource IconPathStatic}" Data="{StaticResource IconBookCover}" Width="16" Height="16" Margin="0,0,7,0" />
                        <TextBlock Text="封面图片" Style="{StaticResource PanelTitle}" />
                    </StackPanel>
                    <TextBlock x:Name="CoverInfo" Text="未设置封面" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="选择封面" Margin="0,0,8,0" Click="BrowseCover_Click" />
                        <Button Style="{StaticResource GhostDangerButton}" Content="移除封面" x:Name="RemoveCoverBtn" IsEnabled="False" Click="RemoveCover_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ====== 元数据表单（网格化） ====== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormLabel}" Text="书名" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TitleBox" Margin="0,0,0,8" />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormLabel}" Text="作者" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="AuthorBox" Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FormLabel}" Text="类型" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="SubjectBox" Margin="0,0,0,8"
                         ToolTip="书籍分类/类型，多个以分号分隔，如：小说;科幻" />

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FormLabel}" Text="出版社" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="PublisherBox" Width="200" Margin="0,0,16,0" />
                    <TextBlock Text="ISBN" Style="{StaticResource FieldLabel}" Width="42" TextAlignment="Right" />
                    <TextBox x:Name="IsbnBox" Width="160" />
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FormLabel}" Text="语言" />
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="LanguageCombo" Width="120" VerticalContentAlignment="Center" Margin="0,0,0,8">
                    <ComboBoxItem Content="zh-CN" IsSelected="True" />
                    <ComboBoxItem Content="zh-TW" />
                    <ComboBoxItem Content="en" />
                    <ComboBoxItem Content="ja" />
                    <ComboBoxItem Content="ko" />
                    <ComboBoxItem Content="fr" />
                    <ComboBoxItem Content="de" />
                </ComboBox>

                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FormLabel}" Text="简介" />
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="DescriptionBox" Style="{StaticResource MultilineTextBox}"
                         Height="140" Margin="0,0,0,4" />
            </Grid>
        </ScrollViewer>

        <!-- ====== 底部按钮（主/次层级） ====== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="确定" IsDefault="True" Click="OK_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="取消" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
