<Project>
  <!--
    TEMPORARY build workaround (companion to Directory.Build.props).
    Directory.Build.props only extends DefaultItemExcludes, but when
    BaseIntermediateOutputPath is redirected to an absolute path outside
    the project, the SDK's default Compile glob does not consistently
    exclude the leftover workspace obj/bin trees, producing duplicate
    AssemblyInfo.cs CS0579 errors. These explicit Compile / None /
    EmbeddedResource / Content Remove rules are imported AFTER the SDK
    targets, so they win over the SDK's default items.
    See Directory.Build.props for full context. DO NOT SHIP.
  -->
  <ItemGroup>
    <Compile          Remove="**/obj/**/*.cs" />
    <Compile          Remove="**/obj_bak/**/*.cs" />
    <Compile          Remove="**/bin/**/*.cs" />
    <Compile          Remove="**/bin_bak/**/*.cs" />
    <None             Remove="**/obj/**" />
    <None             Remove="**/obj_bak/**" />
    <None             Remove="**/bin/**" />
    <None             Remove="**/bin_bak/**" />
    <EmbeddedResource Remove="**/obj/**" />
    <EmbeddedResource Remove="**/obj_bak/**" />
    <EmbeddedResource Remove="**/bin/**" />
    <EmbeddedResource Remove="**/bin_bak/**" />
    <Content          Remove="**/obj/**" />
    <Content          Remove="**/obj_bak/**" />
    <Content          Remove="**/bin/**" />
    <Content          Remove="**/bin_bak/**" />
  </ItemGroup>

  <!--
    构建前自动释放被宿主 EDR / 文件监视器持有的旧 Epubra.exe 句柄。
    遗留的运行实例会锁住输出目录（C:\epubra_bld）下的程序集，导致 MSB3027 复制失败。
    taskkill 失败（无进程）时 ContinueOnError 保证构建不被中断。仅 Windows 生效。
  -->
  <Target Name="KillStaleEpubraBeforeBuild" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="taskkill /IM Epubra.exe /F 2>nul" ContinueOnError="true" IgnoreExitCode="true" EchoOff="true" />
  </Target>
</Project>